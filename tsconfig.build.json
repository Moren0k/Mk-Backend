{
  "extends": "./tsconfig.json",
  // `scripts` queda fuera a propósito: son utilidades de línea de comandos
  // (`pnpm analytics:rebuild` / `analytics:verify`) que corren con ts-node y
  // nunca forman parte del artefacto desplegable. Incluirlas movía la raíz
  // común del proyecto de `src/` a la del repo, y con eso la salida pasaba
  // de `dist/main.js` a `dist/src/main.js`, rompiendo `pnpm start:prod`.
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
