# Plantilla de variables de entorno. Copia este archivo como ".env" y
# reemplaza los valores por los reales. Nunca subas el ".env" real a un repositorio.

# PORT: puerto en el que escucha el servidor HTTP (Fastify).
PORT=3000

# TELEGRAM_BOT_TOKEN: token del bot, se obtiene hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# TELEGRAM_CHAT_ID: id numérico del chat/grupo de Telegram donde el bot envía las alertas.
TELEGRAM_CHAT_ID=-1000000000000

# TIPMINER_BASE_URL: base de la API pública de Tipminer (ver API.MD). Opcional,
# ya trae este valor por defecto.
TIPMINER_BASE_URL=https://api.core.public.tipminer.com

# TIPMINER_PROVIDER_ID: uuid de la mesa Bac Bo (Evolution) en Tipminer. Opcional,
# ya trae este valor por defecto (ver API.MD, sección 1).
TIPMINER_PROVIDER_ID=cc71e81d-8b56-4868-91c7-7224be543dce

# TIPMINER_TIMEZONE: timezone usada al pedir el historial. Opcional.
TIPMINER_TIMEZONE=America/Sao_Paulo

# TIPMINER_API_KEY: reservado para cuando la API deje de ser pública. Hoy no
# requiere autenticación (ver API.MD), déjalo vacío.
TIPMINER_API_KEY=
