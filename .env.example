# Plantilla de variables de entorno. Copia este archivo como ".env" y
# reemplaza los valores por los reales. Nunca subas el ".env" real a un repositorio.

# PORT: puerto en el que escucha el servidor HTTP (Fastify).
PORT=3000

# API_KEY: secreto compartido de la API propia (src/api/), enviado por el
# frontend en el header "X-Api-Key". Se hashea (SHA-256) al arrancar el
# proceso; nunca se compara en texto plano. Si se deja vacía, la API
# rechaza cualquier solicitud (falla cerrado) — ver Mk-Api.md Anexo D §5.
API_KEY=

# ACCESS_PASSWORD: contraseña única del login del panel frontend
# (POST /api/v1/auth/login, ver auth.controller.ts). Si acierta, ese
# endpoint devuelve API_KEY (arriba) — así ni la contraseña ni la API key
# quedan nunca incrustadas en el JS del frontend. Se hashea igual que
# API_KEY; vacía = el endpoint rechaza cualquier contraseña (falla cerrado).
ACCESS_PASSWORD=

# CORS_ALLOWED_ORIGINS: orígenes permitidos, separados por coma (sin
# espacios extra necesarios, se recortan solos). Ej:
# CORS_ALLOWED_ORIGINS=https://mi-frontend.com,https://staging.mi-frontend.com
# Sin definir, el servidor acepta cualquier origen (origin: true) — cómodo
# en desarrollo local, pero se debe definir esta variable antes de exponer
# la API a Internet.
CORS_ALLOWED_ORIGINS=

# RATE_LIMIT_TTL_MS / RATE_LIMIT_LIMIT: ventana (ms) y tope de requests por
# IP dentro de esa ventana, para el rate limiting global (@nestjs/throttler).
# Defaults: 300 requests cada 60000 ms (60s) por IP. Opcionales, ya traen
# estos valores por defecto.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

# TELEGRAM_BOT_TOKEN: token del bot, se obtiene hablando con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# TELEGRAM_CHAT_ID: id numérico del chat/grupo de Telegram donde el bot envía las alertas.
TELEGRAM_CHAT_ID=-1000000000000

# TELEGRAM_PRUEBAS_BOT_TOKEN: token del bot de pruebas, se obtiene hablando con @BotFather en Telegram.
TELEGRAM_PRUEBAS_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# TELEGRAM_PRUEBAS_CHAT_ID: id numérico del chat/grupo de pruebas de Telegram donde el bot envía las alertas.
TELEGRAM_PRUEBAS_CHAT_ID=-2000000000000

# TELEGRAM_PRUEBAS_ENABLED: interruptor de modo pruebas (true/false). En "false"
# el grupo de pruebas no recibe absolutamente nada (ni alertas en vivo de
# streak-4 ni el resumen manual/horario); el grupo oficial sigue funcionando
# normal. No pausa la estrategia de pruebas, solo corta su envío a Telegram.
TELEGRAM_PRUEBAS_ENABLED=true

# TIPMINER_BASE_URL: base de la API pública de Tipminer (ver API.MD). Opcional,
# ya trae este valor por defecto.
TIPMINER_BASE_URL=https://api.core.public.tipminer.com

# TIPMINER_PROVIDER_ID: uuid de la mesa Bac Bo (Evolution) en Tipminer. Opcional,
# ya trae este valor por defecto (ver API.MD, sección 1).
TIPMINER_PROVIDER_ID=cc71e81d-8b56-4868-91c7-7224be543dce

# TIPMINER_TIMEZONE: timezone usada al pedir el historial. Opcional.
TIPMINER_TIMEZONE=America/Sao_Paulo

# TIPMINER_API_KEY: reservado para cuando la API deje de ser pública. Hoy no
# requiere autenticación (ver API.MD), déjalo vacío.
TIPMINER_API_KEY=

# --- Persistencia (PostgreSQL vía Supabase + Prisma) ---
# Infraestructura desacoplada del motor (ver src/infrastructure/persistence/):
# mientras estas dos variables no estén definidas, PrismaService arranca
# deshabilitado y el bot sigue funcionando exactamente igual, sin persistencia.
# Los valores reales se obtienen en el panel de Supabase (Project Settings →
# Database → Connection string). No subir nunca los valores reales a git.

# DATABASE_URL: conexión pooled (pgbouncer, modo transacción, puerto 6543)
# usada por la app en runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: conexión session-mode (puerto 5432), requerida por Prisma
# Migrate (el pooler en modo transacción no soporta los prepared statements
# que usan las migraciones).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# REPORT_CHECKPOINT_INTERVAL_MS: cada cuánto se guarda en la tabla
# report_checkpoints el acumulado de won/lost/alertsSent por canal (ver
# DATABASE.md), para que GET /api/v1/reports/summary sobreviva a un
# reinicio/redeploy sin perder el conteo. Opcional, default 600000 (10 min).
REPORT_CHECKPOINT_INTERVAL_MS=600000

# ANALYTICS_INTERVAL_MS: cada cuánto Racha3IncrementalScheduler dispara
# analytics_racha3_incremental() para procesar las jugadas nuevas hacia las
# tablas derivadas de Analytics (ver ANALYTICS.md). Opcional, default 60000
# (60 s). Un tick sin jugadas nuevas no toca la base: no hace falta bajarlo.
ANALYTICS_INTERVAL_MS=60000

# ─── Racha 3 Test (estrategia EXPERIMENTAL) ────────────────────────────────
# Ver RACHA3-TEST.md. Duplicación controlada de la estrategia Racha 3 que
# consulta la evidencia histórica de Analytics, calcula un score y filtra
# alertas. NUNCA crea operaciones ni apuestas reales: solo simula y manda
# mensajes de DEBUG a su propio canal de Telegram. La estrategia `streak-3`
# de producción no se ve afectada.
#
# RACHA3_TEST_ENABLED: interruptor maestro. Arranca APAGADA: sin "true" el
# coordinator no se suscribe a nada y el canal DEBUG no envía nada.
RACHA3_TEST_ENABLED=false
# El umbral NO se escribe a mano: se calcula como el PUNTO DE EQUILIBRIO de
# la apuesta, es decir la tasa de acierto por debajo de la cual la operacion
# pierde dinero. Sale de la estructura de pago, no del historial de aciertos:
#     umbral = (perdida_por_fallo + peaje_empates) / (perdida + ganancia)
# Con la escalera 1-2-4 y el peaje medido son 87,983 %. El umbral anterior
# (86,87) comparaba un subgrupo contra el grupo que lo contiene y con dos
# categorias aprobaba una y rechazaba la otra por pura aritmetica.
#
# RACHA3_TEST_UMBRAL_MINIMO: piso adicional en la escala del score. El umbral
# efectivo es el MAYOR entre este valor y el equilibrio, asi que solo puede
# volver el sistema mas exigente. Default 0 = manda el equilibrio.
RACHA3_TEST_UMBRAL_MINIMO=0
# RACHA3_TEST_ESCALERA: importe por nivel. Su suma es la perdida por fallo y
# su longitud el numero de intentos. Debe coincidir con la progresion real.
RACHA3_TEST_ESCALERA=1,2,4
# RACHA3_TEST_DEVOLUCION_TIE: fraccion que devuelve un empate. 0.9 = devuelve
# el 90 %, o sea CUESTA el 10 %. Con empates en el 11,5 % de las rondas ese
# 10 % pesa mas que toda la ventaja del lado del banco: mueve el equilibrio
# de 87,500 % a 87,983 %. Si la mesa devuelve el 100 %, poner 1.
RACHA3_TEST_DEVOLUCION_TIE=0.9
# RACHA3_TEST_PAGO_ACIERTO: ganancia neta de un acierto. 1 = pago 1:1.
RACHA3_TEST_PAGO_ACIERTO=1
# Mínimo de oportunidades resueltas que debe respaldar la condición. Bajo
# esto se descarta sin importar el score.
RACHA3_TEST_MIN_MUESTRA=500
# Máximas jugadas sin procesar por Analytics antes de considerar que la
# evidencia no está al día y descartar. Rezago normal: 1-2 jugadas.
RACHA3_TEST_MAX_REZAGO=50
# Bot/chat del canal DEBUG. Si se dejan vacíos se reutilizan los de
# TELEGRAM_PRUEBAS_*: comparte destino sin compartir interruptor.
RACHA3_TEST_TELEGRAM_BOT_TOKEN=
RACHA3_TEST_TELEGRAM_CHAT_ID=
